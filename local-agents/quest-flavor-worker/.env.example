# Copy to .env (gitignored, never commit it) and fill in.

SUPABASE_URL=https://dulcrxolmktmxfxmhtjp.supabase.co

# Plaintext of the quest_flavor_worker_secret Vault secret (migration 0010).
# Retrieve it yourself via the Supabase SQL editor:
#   select decrypted_secret from vault.decrypted_secrets where name = 'quest_flavor_worker_secret';
# Never ask an automated tool to fetch or type this value for you.
FLAVOR_WORKER_SECRET=

# Local Ollama instance (already set up: hardened Docker container, bound
# to 127.0.0.1 only). Defaults shown are what this session configured.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Cloud fallback, used only if Ollama is unreachable. Model slug is
# intentionally left blank here -- pick the current one deliberately.
ANTHROPIC_API_KEY=
ANTHROPIC_FALLBACK_MODEL=
