# Copy to .env.local (gitignored by Vite's default) and fill in from your
# Supabase project's Settings -> API page. If left unset, the app falls
# back to its original fully-local prototype behavior (see
# src/supabaseClient.js) -- nothing breaks, you just don't get real
# accounts/Admin Console until these are set.
#
# VITE_SUPABASE_ANON_KEY takes the "publishable key" (Supabase's current
# name for it -- older projects/docs call it the "anon key", same thing,
# safe to expose to the frontend). Never put the "secret key" (formerly
# "service_role key") here -- that one bypasses RLS and is server-only,
# used only in server/README.md's Edge Function setup.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe's publishable key (safe to expose to the frontend -- it can only
# tokenize card details, never charge anything on its own). From your
# Stripe Dashboard's Developers -> API keys page (test mode to start). If
# left unset, the "Post a Contract" card-collection step doesn't render
# and posting a scrip quest falls back to the local prototype behavior --
# see src/stripeClient.js.
VITE_STRIPE_PUBLISHABLE_KEY=
